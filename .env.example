# Base de datos PostgreSQL (Supabase). Copia este archivo a `.env.local` y pega tu URL.
# En Supabase: Dashboard → Project → Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxx.supabase.co:6543/postgres

# Contraseña inicial del usuario administrador (solo se usa al crear la BD por primera vez).
ADMIN_PASSWORD=cambia-esta-contrasena
